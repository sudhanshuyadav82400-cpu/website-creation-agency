GMAIL_USER="sudhanshuyadav82400@gmail.com"
GMAIL_APP_PASSWORD=""

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="sudhanshuyadav82400@gmail.com"
SMTP_PASS=""
SMTP_SECURE="false"

# OpenRouter API Key (for AI-powered features)
OPENROUTER_API_KEY=""

